# Copy to backend/.env for local dev, or set these in Railway.
# Everything has a safe default; the only one you'll really want is ACCESS_TOKEN in prod.

# --- Storage ---
# Local: leave blank (uses ./data). Railway: set to the mounted volume, e.g. /data
DATA_DIR=

# --- Database ---
# Local: leave blank (SQLite in DATA_DIR). Railway: the Postgres plugin sets this.
DATABASE_URL=

# --- Auth ---
# Blank = open (local dev). In prod set a long random string; the frontend sends it.
ACCESS_TOKEN=

# --- Reliability ---
AUTO_UPDATE_YTDLP=true      # Layer 1: nightly self-update of yt-dlp
YTDLP_UPDATE_HOUR=4
MAX_RETRIES=3               # Layer 3
RETRY_BACKOFF_SECONDS=5
PER_CLIP_DELAY_SECONDS=2
PROXY_URL=                  # Layer 4: residential proxy, e.g. http://user:pass@host:port

# YouTube PO token — required to download from Railway's datacenter IP.
# Without it, YouTube returns HTTP 403 or "Sign in to confirm you're not a bot".
# Get one from: https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
# Set in Railway env vars: YTDLP_PO_TOKEN=<your-token>
YTDLP_PO_TOKEN=

# Anti-ban pacing (true = randomized 10-20s pause between downloads for X/TikTok;
# YouTube uses lighter pacing to avoid its 403 on delayed media-URL fetches)
YTDLP_SLEEP_PRESET=true

# --- Worker (Layer 5 hybrid) ---
# web        = API + in-process worker (default)
# web_only   = API only (pair with a remote worker box)
# worker_only= run `python -m backend.app.worker` on a home/residential-IP machine
WORKER_MODE=web

# --- Encode ---
VIDEO_ENCODER=libx264       # Railway has no VideoToolbox; libx264 is portable
ENCODE_FPS=30

# --- Observability ---
ALERT_WEBHOOK_URL=          # Slack/Discord webhook; POSTed on a source failure spike
ALERT_FAILURE_THRESHOLD=0.5

# --- CORS ---
# In prod set to your Vercel URL, e.g. https://scrapper.nodepilot.dev
CORS_ORIGINS=*

# --- Social Publishing (Upload-Post) ---
# API key from https://app.upload-post.com (API Keys). Connect channels under
# Manage Users; each profile+network becomes a pickable account.
UPLOADPOST_API_KEY=
# Visibility for queue posts: public | unlisted | private (default public).
# PUBLISH_PRIVACY=

# --- AI Metadata & Speech (Google Gemini) ---
# API key from Google AI Studio (for viral captions, titles, tags, and Gemini 3.8 Flash TTS speech)
GEMINI_API_KEY=
# Gemini LLM model id (default gemini-3.8-flash)
# GEMINI_MODEL=
# Gemini TTS model id: gemini-3.8-flash-tts (high fidelity/acting) or gemini-3.8-flash-lite-tts (fast bulk)
# GEMINI_TTS_MODEL=
# Default prebuilt studio voice: Puck, Kore, Fenrir, Charon, Aoede, Zephyr, Algenib, etc.
# GEMINI_TTS_VOICE=

# --- Posting schedule (SocialPilot queue) ---
# Defaults match socialpilot_Ai: every 2h, 8am-10pm Eastern, one post per
# pipeline per slot. Uncomment only to override.
# POST_TIMEZONE=
# POST_START_HOUR=
# POST_END_HOUR=
# POST_INTERVAL_HOURS=
# Days after posting before a posted/archived item is removed and its Drive
# file moved to trash (default 4). 0 disables.
# ARCHIVE_DELETE_DAYS=

# --- LongForm Studio ---
# TMDB (themoviedb.org → Settings → API). Hobby/non-commercial use.
# The Read Access Token is TMDB's default (sent as Bearer); the v3 key is the fallback.
API_Read_Access_Token=
TMDB_API_KEY=
# Google Cloud Text-to-Speech API key (Chirp voice; same key manhwa uses).
TTS_API_KEY=
# TTS_VOICE=en-US-Chirp3-HD-Charon
# STUDIO_REGION=US
# STUDIO_CHANNEL_NAME=Screen Central
# Drive folder for finished breakdowns: a folder inside a Shared Drive where the
# service account is Content manager (service accounts can't store files in My Drive).
# Leave empty to use/create "LongForm Studio" under the YouTube folder.
LONGFORM_DRIVE_FOLDER_ID=

# --- Database Backups ---
# Nightly snapshot at 3:00 am Eastern to local disk (7 days) and Google Drive (30 days)
# BACKUP_ENABLED=
# BACKUP_HOUR=
# BACKUP_TIMEZONE=
# BACKUP_KEEP_LOCAL=
# BACKUP_KEEP_DRIVE=
# Folder ID of "Scrapper Backups" in Google Shared Drive:
# BACKUP_DRIVE_FOLDER_ID=

