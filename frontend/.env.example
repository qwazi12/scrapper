# Copy to frontend/.env.local for local dev, or set in Vercel project settings.

# The Railway backend URL. Local dev default is http://127.0.0.1:8000.
# In prod: https://api.scrapper.nodepilot.dev
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional: preset the access token (otherwise entered in the UI's Connection panel
# and stored in the browser's localStorage). Leave blank to keep it out of the build.
NEXT_PUBLIC_ACCESS_TOKEN=
